# Copy to backend/.env (or export in your shell). Never commit real values.

# development | test | production
JUSTICE_ENV=development
DATABASE_URL=postgresql+psycopg://justice:CHANGE_ME@localhost:5432/justice
# Used to build links in emails (verification etc.)
PUBLIC_APP_URL=http://localhost:3000
# true in production (HTTPS only). Defaults to false only in development/test.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# dev_outbox (development only; refused in production) | smtp (not implemented yet)
EMAIL_BACKEND=dev_outbox
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# Frontend (frontend/.env.local): where Next.js proxies /api
BACKEND_URL=http://127.0.0.1:8000
REVERIFY_AFTER_DAYS=180
